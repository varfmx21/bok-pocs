SECRET_KEY_FLASK='<YOUR-SECRET-KEY>'
PEPPER='<YOUR-PEPPER>'
PEPPER_VERSION='<VERSION>'
AZURE_SQL_CONNECTIONSTRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=poc-sql-security.database.windows.net,1433;DATABASE=poc-security-db;UID=<your-sql-username>;PWD=<your-sql-password>;Encrypt=yes;TrustServerCertificate=yes;Connection Timeout=30;ColumnEncryption=Enabled;"